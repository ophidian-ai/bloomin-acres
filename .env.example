# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Bread Box Club — optional overrides. Defaults are the live Club product/price
# created 2026-11-09 (prod_Vb6dndEWLhptAw / price_1UZuQ6JYJib0yIyhjNFanuQM).
# STRIPE_CLUB_DISCOUNT_ID falls back to an auto-created 5% coupon "BREADBOX-CLUB-5".
STRIPE_CLUB_PRICE_ID=
STRIPE_CLUB_PRODUCT_ID=
STRIPE_CLUB_DISCOUNT_ID=
# STRIPE_PORTAL_CONFIG_ID=   (omit to use the account's default portal configuration)
STRIPE_REFERRAL_REG_COUPON=
STRIPE_REFERRAL_CLUB_COUPON=

# Order + Club emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ORDER_NOTIFICATION_EMAIL=
# SITE_URL=https://bloominacresmarket.com   (links in emails)

# Google
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=

# Delivery (optional — set STRIPE_DELIVERY_PRICE_ID to a Stripe Price for the delivery fee)
# STRIPE_DELIVERY_PRICE_ID=

# CORS (optional, defaults to VERCEL_URL or http://localhost:3000)
# ALLOWED_ORIGIN=
